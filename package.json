{
  "name": "supplierops-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first SupplierOps Lab for auditable invoice exception resolution.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs,md}\" \"docs/**/*.md\" \".github/**/*.md\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs,md}\" \"docs/**/*.md\" \".github/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "verify:database": "node scripts/verify-database.mjs",
    "verify:provider-live": "npm run build && node scripts/verify-live-provider.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run verify:database && npm run build && npm run verify:secrets",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs,md}\" \"docs/**/*.md\" \".github/**/*.md\"",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "42.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.supplierops.lab",
    "productName": "SupplierOps Lab",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
